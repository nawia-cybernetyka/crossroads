{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Nawia Crossroads Utility",
  "version": "0.1.0",
  "identifier": "com.nawiacybernetyka.crossroads",
  "build": {
    "frontendDist": "../app",
    "beforeDevCommand": "npm run sync",
    "beforeBuildCommand": "npm run sync"
  },
  "app": {
    "windows": [
      {
        "title": "Nawia Crossroads Utility",
        "width": 760,
        "height": 720,
        "resizable": true,
        "fullscreen": false,
        "minWidth": 600,
        "minHeight": 500
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
